@model DashboardViewModel
@{
ViewData["Title"] = "Placement Report";
}
<section class="page-heading report-heading">
<div>
<p class="eyebrow">PLACEMENT REPORT · @DateTime.Now.ToString("d
MMMM yyyy")</p>
<h1>Placement summary</h1>
<p class="text-muted">Printable report for the current sample placement
batch.</p>
</div>
<div class="report-actions">
<button class="btn btn-primary" type="button"
onclick="window.print()">Print / Save as PDF</button>

<a class="btn btn-outline-primary" asp-controller="Home" asp-
action="Index">Back to dashboard</a>

</div>
</section>
<section class="metrics-grid report-metrics" aria-label="Placement summary">
<article class="metric-card"><span class="metric-label">Total

students</span><strong class="metric-
value">@Model.TotalStudents</strong></article>

<article class="metric-card"><span class="metric-label">Placed</span><strong
class="metric-value">@Model.PlacedStudents</strong></article>
<article class="metric-card"><span class="metric-label">Not

placed</span><strong class="metric-
value">@Model.NotPlacedStudents</strong></article>
<article class="metric-card metric-highlight">
<span class="metric-label">Placement rate</span>

<strong class="metric-
value">@Model.PlacementPercentage.ToString("F2")%</strong>

</article>
</section>
<section class="content-panel report-panel">
<div class="section-heading">
<div>
<p class="eyebrow">STUDENT-WISE RESULTS</p>
<h2>Placement details</h2>
</div>
<p class="report-package">Highest package
<strong>@Model.HighestPackageLpa.ToString("F2") LPA</strong></p>
</div>
<div class="table-responsive">
<table class="table data-table align-middle">
<thead>
<tr>
<th scope="col">Enrollment no.</th>
<th scope="col">Student</th>
<th scope="col">Department</th>
<th scope="col">Company</th>
<th scope="col">Job role</th>
<th scope="col" class="text-end">Package (LPA)</th>
<th scope="col">Status</th>
</tr>
</thead>
<tbody>
@foreach (var student in Model.Students)
{
<tr>
<td>@student.EnrollmentNo</td>
<td>@student.StudentName</td>
<td>@student.Department</td>
<td>@(student.CompanyName ?? "—")</td>
<td>@(student.JobRole ?? "—")</td>
<td class="text-end">@(student.PackageLpa?.ToString("F2") ?? "—

")</td>

<td>@(student.IsPlaced ? "Placed" : "Not placed")</td>
</tr>
}
</tbody>
</table>
	</div>
</section>